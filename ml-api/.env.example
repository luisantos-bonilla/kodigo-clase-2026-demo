# Copie este archivo a .env y complete API_KEY. Nunca versione .env.

# Obligatoria, mínimo 32 caracteres. Para generarla:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Tamaño máximo del cuerpo de una solicitud, en bytes.
MAX_BODY_BYTES=10240

APP_NAME="API de clasificación de Iris"
API_VERSION=1.0.0

# development habilita /docs; production lo deshabilita.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Ejecución local sin Docker (Compose fija los del contenedor).
HOST=127.0.0.1
PORT=8000

# Interfaz y puerto publicados por Docker Compose.
# 0.0.0.0 = accesible desde la red; 127.0.0.1 = solo este equipo.
BIND_ADDRESS=0.0.0.0
HOST_PORT=8000

# Ruta relativa al directorio de ejecución. Si cambia el modelo, cambie la huella.
MODEL_PATH=app/models/model.joblib
MODEL_SHA256=ee6ec66a04af33aa66237b8adab91baffbbcba5c8557652747df8eac0368c742

# Lista JSON de orígenes autorizados; vacía deshabilita CORS.
CORS_ALLOWED_ORIGINS=[]
